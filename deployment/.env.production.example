# Application
NODE_ENV=production
PORT=3000
CLIENT_URL=http://YOUR_EC2_PUBLIC_IP
BASE_API_URL=api

# MongoDB
MONGO_URI=mongodb://mongo:27017/mern_ecommerce

# Authentication
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Database seed credentials
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# Optional email
MAILCHIMP_KEY=
MAILCHIMP_LIST_KEY=

MAILGUN_KEY=
MAILGUN_DOMAIN=
MAILGUN_EMAIL_SENDER=

# AWS
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=